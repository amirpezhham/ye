    "api:build": "tsc -p tsconfig.server.json",
    "api:start": "node dist-server/server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "db:create-admin": "tsx server/create-admin.ts"
  },
  "dependencies": {
