  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && npm run api:build",
    "start": "npm run api:start",
    "lint": "eslint src",
