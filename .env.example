# ---------- عمومی ----------
NODE_ENV=development
# پورت API. اگر هاست متغیر PORT تزریق کند، همان استفاده می‌شود (API_PORT اولویت دارد).
API_PORT=4000

# ---------- پایگاه‌داده ----------
DATABASE_URL=postgresql://yedood:change-this-password@localhost:5432/yedood
# حالت SSL: true | false | no-verify — پیش‌فرض در production برابر true است.
# DATABASE_SSL=false

# ---------- امنیت ----------
# باید دقیقاً با آدرس فرانت‌اند یکی باشد، وگرنه کوکی نشست (SameSite=strict) ارسال نمی‌شود.
ADMIN_ORIGIN=http://localhost:4173
# با «openssl rand -hex 24» بسازید؛ حداقل ۳۲ کاراکتر.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_SESSION_HOURS=12

# ---------- سرو کردن فرانت‌اند از Express ----------
# در NODE_ENV=production به‌صورت پیش‌فرض true است.
SERVE_STATIC=false
# STATIC_DIR=./dist
# آدرس عمومی سایت برای robots.txt و sitemap.xml (اختیاری؛ در نبودش از هدر Host استفاده می‌شود)
# PUBLIC_SITE_URL=https://example.com

# ---------- اعلان سفارش در تلگرام ----------
# فقط روی سرور. هرگز در فرانت‌اند یا متغیرهای VITE_* قرار نگیرد.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
